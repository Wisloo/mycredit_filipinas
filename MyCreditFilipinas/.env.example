# ──────────────────────────────────────────────────
# MyCredit Filipinas – Environment Variables
# Copy this file to .env.local and fill in your values.
# Also add ALL of these to Vercel → Project Settings → Environment Variables.
# ──────────────────────────────────────────────────

# Supabase PostgreSQL (Session mode pooler — required for pg driver)
# Found in: Supabase Dashboard → Project Settings → Database → Connection pooling
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase project URL and anon key (for Storage uploads — server-side only)
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# JWT Secret – CHANGE THIS for production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-string
